{
  "id": "./",
  "name": "Negen · Sudoku",
  "short_name": "Negen",
  "description": "Sudoku zoals het hoort: rustig, eerlijk en altijd op te lossen met logica. Vijf niveaus van makkelijk tot meester, elke dag een puzzel van de dag, hints die uitleggen waarom. Werkt ook offline.",
  "lang": "nl",
  "dir": "ltr",
  "categories": ["games", "puzzle"],
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait",
  "background_color": "#e8ecf3",
  "theme_color": "#f4f6f9",
  "launch_handler": { "client_mode": ["focus-existing", "navigate-existing", "auto"] },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
